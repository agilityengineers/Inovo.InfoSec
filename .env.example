# ---------------------------------------------------------------- required

# Postgres. On Replit, open the Database tool and this is set for you.
DATABASE_URL=postgres://user:password@host/db

# Admin sign-in (/admin). Generate the secret with: openssl rand -base64 32
ADMIN_EMAIL=admin@inovois.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------- optional
# Every integration is off unless its key is present; the funnel works without
# them, and the admin's integration log records each as "skipped".

# HubSpot — private app token with crm.objects.contacts.write and notes scope.
HUBSPOT_ACCESS_TOKEN=
INTEGRATION_HUBSPOT=on

# Zapier — Catch Hook URL. The admin's Integrations tab overrides this value.
ZAPIER_HOOK_URL=
INTEGRATION_ZAPIER=on

# Email — Resend API key and the verified From address.
RESEND_API_KEY=
EMAIL_FROM="Inovo Infosec <no-reply@inovois.com>"
INTEGRATION_EMAIL=on

# Cloudflare Turnstile. With no secret the check is skipped; the honeypot still runs.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Postgres tuning. Set PGSSL=disable for a local database without TLS.
PGPOOL_MAX=5
PGSSL=
